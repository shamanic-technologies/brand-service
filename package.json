{
  "name": "brand-service",
  "version": "1.0.0",
  "description": "A microservice to handle brand information and sales profiles.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && pnpm generate:openapi",
