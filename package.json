    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.8",
    "supertest": "^7.2.2",
