    "express": "^4.22.3",
    "googleapis": "^161.0.0",
    "heic-convert": "^2.1.0",
    "multer": "^2.5.0",
    "p-retry": "^8.0.0",
    "postgres": "^3.4.8",
    "sharp": "^0.35.5",
    "tldts": "^7.4.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
